# Internal URL of the existing API gateway. This is read on the server only.
API_GATEWAY_URL=http://localhost:3000

# Browser-restricted Google Maps JavaScript key for homepage place suggestions and maps.
# Enable Maps JavaScript API and Places API (New); allow this site's origin as a referrer.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Production HTTPS sets secure cookies automatically. Set the public site URL for deployment documentation.
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# App download destinations. Leave empty to show a "coming soon" download page.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
