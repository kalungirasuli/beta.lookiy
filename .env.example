# Internal URL of the existing API gateway. This is read on the server only.
API_GATEWAY_URL=http://localhost:3000

# Google OAuth Web application client ID; must match auth-service GOOGLE_WEB_CLIENT_ID.
# Register this website's HTTPS origin (and localhost:3200 for development) as authorized JavaScript origins.
# This is a public OAuth identifier, not a client secret. Read at runtime by /api/session/google-config.
GOOGLE_WEB_CLIENT_ID=

# Maps JavaScript API key restricted to this website. Signed-in browsers receive it at runtime.
# Use a dedicated website key, separate from the geo service's API key.
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_MAP_ID=

# Canonical site origin used in page metadata. HTTPS enables secure session cookies.
SITE_URL=http://localhost:3200

# App download destinations. Leave empty to show a "coming soon" download page.
APP_STORE_URL=
PLAY_STORE_URL=
